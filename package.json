{
  "name": "settlers",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/cloudflare.mjs dev --port 3000",
    "build": "node scripts/cloudflare.mjs build",
    "start": "node scripts/cloudflare.mjs preview --port 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev:vinext": "node scripts/cloudflare.mjs dev --port 3001",
    "build:vinext": "npm run build",
    "start:vinext": "node scripts/cloudflare.mjs preview --port 3001",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.2",
    "@vinext/cloudflare": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.554.0",
    "next": "^16.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "react-zoom-pan-pinch": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "three": "^0.185.1",
    "vinext": "^1.2.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "cf": "^1.0.0-beta.18",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "^27.3.0",
    "node": "^24.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
